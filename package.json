{
  "name": "bookmarker-for-nextcloud",
  "version": "0.32.0",
  "type": "module",
  "description": "Browser extension for managing Nextcloud bookmarks",
  "keywords": [
    "nextcloud",
    "bookmarks",
    "browser-extension",
    "chrome-extension"
  ],
  "author": "plushbyte",
  "license": "ISC",
  "homepage": "https://plushbyte.com/chrome/bookmarker-for-nextcloud",
  "repository": {
    "type": "git",
    "url": "https://github.com/plushbyte/bookmarker-for-nextcloud"
  },
  "bugs": {
    "url": "https://github.com/plushbyte/bookmarker-for-nextcloud/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "clean": "del /f /q src\\options\\options.css src\\popup\\css\\popup.css 2>nul & exit /b 0",
    "clean:dist": "if exist dist rmdir /s /q dist & if exist .parcel-cache rmdir /s /q .parcel-cache",
    "build:css:options": "npx @tailwindcss/cli -i ./src/options/input.css -o ./src/options/options.css --minify",
    "build:css:popup": "npx @tailwindcss/cli -i ./src/popup/css/input.css -o ./src/popup/css/popup.css --minify",
    "build:css": "npm run build:css:options && npm run build:css:popup",
    "prebuild": "npm run clean && npm run clean:dist",
    "build": "npm run build:css && vite build",
    "predev": "npm run clean && npm run clean:dist",
    "dev": "npm run build:css && vite",
    "watch": "npm run build:css && vite",
    "prebuild:dev": "npm run clean && npm run clean:dist",
    "build:dev": "npm run build:css && vite build --mode development",
    "predeploy": "npm run clean && npm run clean:dist",
    "deploy": "npm run build:css && vite build --mode production",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "sonar:scan": "npm run test:coverage && sonar-scanner",
    "check:hn": "node tools/hn-keyword-check/check.js",
    "perf": "node tools/perf/case-runner.js --root . --case",
    "perf:compare": "node tools/perf/compare.js"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@linthtml/linthtml": "^0.10.2",
    "@tailwindcss/cli": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "daisyui": "^5.7.46",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rollup": "^4.63.5",
    "sonarqube-scanner": "^5.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@yaireo/tagify": "^4.39.0",
    "idb": "^8.0.3",
    "textfit": "^2.4.0"
  }
}
